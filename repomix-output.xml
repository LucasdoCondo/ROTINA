              <Hr style={divider} />
              <Text style={detailRow}>
                <span style={detailLabel}>Plano:</span> {planName}
              </Text>
              <Text style={detailRow}>
                <span style={detailLabel}>Valor:</span> R$ {amount}
              </Text>
              <Text style={detailRow}>
                <span style={detailLabel}>Forma de pagamento:</span> {billingType}
              </Text>
