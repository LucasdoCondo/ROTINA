.modal-header h2 {
  font-size: 20px;
  font-weight: 700;
  color: #1a1a2e;
}

.modal-close {
  background: none;
  border: none;
  cursor: pointer;
  padding: 4px;
  color: #666;
  transition: color 0.2s;
}

.modal-close:hover {
  color: #c62828;
}

.modal-body {
  padding: 24px;
}

/* Diff Info */
.diff-info {
  background: #f8f9fa;
  border-radius: 8px;
  padding: 16px;
  margin-bottom: 24px;
}

.diff-info p {
  margin-bottom: 8px;
  font-size: 14px;
  color: #333;
}

.diff-info p:last-child {
  margin-bottom: 0;
}

.diff-info strong {
  color: #1a1a2e;
}

/* Diff Section */
.diff-section h3 {
  font-size: 16px;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 16px;
}

.diff-context-msg {
  margin-bottom: 12px;
  font-size: 14px;
  color: #555;
}

/* ═══════════════════════════════════════════════
   DiffViewer (side-by-side)
   ═══════════════════════════════════════════════ */
.diff-viewer {
  font-family: 'Courier New', monospace;
  font-size: 13px;
}

.diff-viewer-empty {
  font-size: 14px;
  color: #999;
  font-style: italic;
  text-align: center;
  padding: 24px;
}

/* Cabeçalho da grade (3 colunas) */
.diff-viewer-header {
  display: grid;
  grid-template-columns: 1fr 1.5fr 1.5fr;
  gap: 12px;
  padding: 10px 12px;
  border-bottom: 2px solid #e0e0e0;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  font-weight: 600;
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: #555;
}

/* Container rolável das linhas */
.diff-viewer-body {
  max-height: 350px;
  overflow-y: auto;
  padding-right: 4px;
  margin-top: 8px;
}

/* Cada linha do diff */
.diff-viewer-row {
  display: grid;
  grid-template-columns: 1fr 1.5fr 1.5fr;
  gap: 12px;
  padding: 10px 12px;
  border-radius: 6px;
  margin-bottom: 6px;
  align-items: center;
  transition: background-color 0.15s;
}

.diff-viewer-changed {
  background: #f8f9fa;
  border: 1px solid #e0e0e0;
}

.diff-viewer-unchanged {
  opacity: 0.55;
}

/* Coluna "Campo" */
.diff-viewer-field {
  font-weight: 700;
  color: #1a1a2e;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Coluna "Valor Anterior" */
.diff-viewer-old {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  word-break: break-all;
}

.diff-viewer-old-highlight {
  color: #c62828;
  background: #fff5f5;
  padding: 2px 6px;
  border-radius: 4px;
}

/* Coluna "Novo Valor" */
.diff-viewer-new {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  word-break: break-all;
}

.diff-viewer-new-highlight {
  color: #2e7d32;
  background: #f0fff0;
  padding: 2px 6px;
  border-radius: 4px;
}

/* Valor nulo/vazio */
.diff-viewer-null {
  color: #999;
  font-style: italic;
}

/* Responsividade do DiffViewer */
@media (max-width: 768px) {
  .diff-viewer-header,
  .diff-viewer-row {
    grid-template-columns: 1fr 1fr 1fr;
    gap: 8px;
    padding: 8px;
    font-size: 11px;
  }
}

/* Retenção Modal */
.retention-warning {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 12px;
  padding: 20px;
  background: #fff3e0;
  border-radius: 8px;
  margin-bottom: 20px;
  color: #e65100;
}

.retention-warning p {
  font-size: 14px;
}

.retention-note {
  font-size: 12px !important;
  color: #999;
  font-style: italic;
}

.retention-input {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-bottom: 24px;
}

.retention-input label {
  font-size: 14px;
  font-weight: 600;
  color: #333;
}

.retention-input input {
  padding: 10px 12px;
  border: 1px solid #ddd;
  border-radius: 6px;
  font-size: 16px;
}

.retention-input small {
  font-size: 12px;
  color: #999;
}

.retention-actions {
  display: flex;
  gap: 12px;
  justify-content: flex-end;
}

.btn-cancel {
  padding: 10px 20px;
  background: white;
  border: 1px solid #ddd;
  border-radius: 6px;
  font-weight: 600;
  cursor: pointer;
  color: #666;
  transition: all 0.2s;
}

.btn-cancel:hover {
  background: #f5f5f5;
}

.btn-confirm-purge {
  padding: 10px 20px;
  background: #c62828;
  color: white;
  border: none;
  border-radius: 6px;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.2s;
}

.btn-confirm-purge:hover:not(:disabled) {
  background: #b71c1c;
}

.btn-confirm-purge:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

/* Responsividade */
@media (max-width: 768px) {
  .auditoria-header h1 {
    font-size: 24px;
  }

  .filtros-grid {
    grid-template-columns: 1fr;
  }

  .auditoria-tabela {
    font-size: 12px;
  }

  .auditoria-tabela th,
  .auditoria-tabela td {
    padding: 8px 10px;
  }

  .col-ip {
    display: none;
  }

  .paginacao {
    flex-direction: column;
    gap: 12px;
  }
}

/* ═══════════════════════════════════════════════
   Página de Demo (AuditoriaDemo)
   ═══════════════════════════════════════════════ */
.auditoria-demo {
  max-width: 1400px;
  margin: 0 auto;
  padding: 24px;
}

.auditoria-demo-header {
  margin-bottom: 24px;
}

.auditoria-demo-header h1 {
  font-size: 32px;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 8px;
  display: flex;
  align-items: center;
  gap: 12px;
}

.auditoria-demo-subtitle {
  color: #666;
  font-size: 16px;
}
