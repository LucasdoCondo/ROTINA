# Copie este arquivo para `.env` e ajuste conforme o ambiente.
# URL base da API do ROTINA (backend Express em backend/).
#   dev local        → http://localhost:3000/api/v1
#   prod same-origin → deixe a variável UNDEFINED (o cliente usa /api/v1,
#                      servido pela Function da Vercel na mesma origem)
#   prod API em OCI  → https://api.seu-dominio.com/api/v1
VITE_API_URL=http://localhost:3000/api/v1
