# ─────────────────────────────────────────────
#  ROTINA — Gitignore raiz
# ─────────────────────────────────────────────

# Artefatos de ferramentas de análise/pacotes
repomix-output.xml
repomix-output.*

# Logs e temporários
*.log
logs/
tmp/
.temp/

# SO / editor
.DS_Store
Thumbs.db

# Variáveis de ambiente / segredos (NUNCA versionar!)
.env
.env.*
!*.env.example
# Rascunhos/exports de env com nomes não padrão (ex.: "nano .env.production.txt")
nano*
*.env*.txt

# Dependências instaladas localmente
node_modules/

# Link local do projeto Vercel
.vercel/
