# ─────────────────────────────────────────────────────────────
#  ROTINA Backend — Variables de entorno
#  Copia este archivo a `.env` y ajusta los valores.
# ─────────────────────────────────────────────────────────────

# Entorno
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# Nº de proxies en frente del servidor (requerido para rate-limit por IP real)
TRUST_PROXY=1

# Base de datos (PostgreSQL)
# Usa la cadena del docker-compose incluido en el proyecto
DATABASE_URL=postgresql://rotina:rotina@localhost:5432/rotina_dev?schema=public

# JWT — Access token (firma HS256). Mínimo 32 caracteres.
JWT_ACCESS_SECRET=change-me-please-32-chars-min-secret
JWT_ACCESS_TTL=15m

# Refresh tokens opacos (256 bits, se guardan hasheados con Argon2id)
REFRESH_TOKEN_TTL_DAYS=7

# Argon2id (OWASP recomienda: memory 64MB, tiempo 3, paralelismo 1)
ARGON2_MEMORY_KB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# CORS — lista separada por comas. "*" habilita reflect-origin (solo dev).
CORS_ORIGINS=*

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10