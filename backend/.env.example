PORT=3001
NODE_ENV=development

# ============================================
# Database (PostgreSQL) — Neon (Serverless)
# ============================================
# Local: postgresql://postgres:senha@localhost:5432/saas_sistema?schema=public
# Produção (Neon): postgres://user:pass@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true
DATABASE_URL="postgresql://postgres:sua_senha@localhost:5432/saas_sistema?schema=public"

# ============================================
# JWT (Autenticação)
# ============================================
JWT_SECRET=sua_chave_secreta_super_segura_aqui
JWT_EXPIRES_IN=7d

# ============================================
# CORS
# ============================================
# Local: http://localhost:3000
# Produção: https://app.rotina.com.br
CORS_ORIGIN=http://localhost:3000

# ============================================
# Redis / Filas — Upstash (Serverless Redis)
# ============================================
# Obter em: https://console.upstash.com
# UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="xxxx"

# ============================================
# E-mail Transacional — Resend + React Email
# ============================================
# Obter em: https://resend.com
# Dev: onboarding@resend.dev (só envia para seu e-mail cadastrado)
# Prod: noreply@rotina.com.br (domínio verificado com SPF/DKIM/DMARC)
# RESEND_API_KEY="re_xxxx"
# EMAIL_FROM="ROTINA <noreply@rotina.com.br>"
# APP_NAME="ROTINA"

# ============================================
# Pagamento — Asaas (Brasil) ou Stripe (Global)
# ============================================
# Asaas (recomendado para Brasil):
# Obter em: https://sandbox.asaas.com
# ASAAS_API_KEY="seu_token_aqui"
# ASAAS_ENV="sandbox" # ou "production"
# ASAAS_WEBHOOK_TOKEN="token_de_seguranca_do_webhook"

# Stripe (alternativa global):
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ============================================
# Storage — Supabase (Armazenamento de Arquivos)
# ============================================
# Obter em: https://supabase.com
# SUPABASE_URL="https://xxxx.supabase.co"
# SUPABASE_SERVICE_KEY="eyJxxxx"

# ============================================
# Monitoramento — Sentry (Error Tracking)
# ============================================
# SENTRY_DSN="https://xxxx@sentry.io/xxxx"

# ============================================
# App
# ============================================
# URL pública da aplicação (para links em e-mails)
# APP_URL="https://app.rotina.com.br"
